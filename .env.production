# Production Environment Variables
# Copiar como .env.production y configurar valores reales

# API Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
NODE_ENV=production

# Database Configuration (Heroku proporcionará DATABASE_URL automáticamente)
DATABASE_URL=postgresql://user:password@localhost:5432/panas_db
REDIS_URL=redis://localhost:6379

# Algorand Configuration
ALGORAND_NETWORK=mainnet
ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://mainnet-idx.algonode.cloud
ALGORAND_API_TOKEN=your_algorand_api_token_here

# OpenAI Configuration
OPENAI_API_KEY=your_production_openai_key_here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Panacea API Central Integration
PANACEA_API_URL=https://panacea-api-central.herokuapp.com
PANACEA_API_KEY=your_production_panacea_api_key_here

# PANAS Token Configuration
PANAS_TOTAL_SUPPLY=1000000
PANAS_DECIMALS=6
PANAS_TOKEN_NAME=PANAS
PANAS_USE_CASE=medical_research_incentive

# Security
SECRET_KEY=your_super_secret_key_here_min_32_chars
JWT_SECRET=your_jwt_secret_key_here
ALLOWED_HOSTS=your-domain.com,your-app.herokuapp.com

# External Services
HEROKU_API_KEY=your_heroku_api_key_here
VERCEL_TOKEN=your_vercel_token_here
GITHUB_TOKEN=your_github_token_here
HUGGING_FACE_TOKEN=your_hf_token_here

# Monitoring y Logging
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE=10485760

# CORS
CORS_ORIGINS=https://your-frontend.com,https://your-app.vercel.app
