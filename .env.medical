# Medical GPT Integration Environment Variables

# OpenAI API Key para integración con ChatGPT
OPENAI_API_KEY=your_openai_api_key_here

# URLs de servicios
PANAS_API_URL=http://panas-api:8000
MEDICAL_GPT_API_URL=http://medical-gpt-api:5003

# Configuración específica para asistentes médicos
MEDICAL_ASSISTANT_MODEL=gpt-4
MEDICAL_ASSISTANT_TEMPERATURE=0.7
MEDICAL_ASSISTANT_MAX_TOKENS=1000

# Dominios NFD de PANAS
NFD_DOMAIN_MAIN=10.panas.algo
NFD_DOMAIN_TOKENIZATION=tokenizado.algo
NFD_DOMAIN_MEDICAL=panacea.icono.algo
NFD_DOMAIN_ASSETS=activo.algo

# Sitio web principal
PANAS_WEBSITE=https://boliviachic.com

# Configuración de logging
LOG_LEVEL=INFO
LOG_FORMAT=json
